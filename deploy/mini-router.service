# systemd unit for mini-router on an Orange Pi Zero 3 (or any Linux box).
#   sudo cp mini-router /usr/local/bin/ && sudo useradd -r -m -d /var/lib/mini-router mini-router
#   sudo cp deploy/mini-router.service /etc/systemd/system/ && sudo systemctl enable --now mini-router
[Unit]
Description=mini-router AI API router
After=network-online.target
Wants=network-online.target

[Service]
User=mini-router
Group=mini-router
Environment=DATA_DIR=/var/lib/mini-router
Environment=HOSTNAME=0.0.0.0
Environment=PORT=20128
Environment=RUST_LOG=info
# Uncomment to force a key even from localhost:
# Environment=REQUIRE_API_KEY=true
ExecStart=/usr/local/bin/mini-router
Restart=on-failure
RestartSec=3
# Memory guard: the router idles far below this; the limit protects the board.
MemoryMax=128M
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/mini-router
PrivateTmp=true

[Install]
WantedBy=multi-user.target
